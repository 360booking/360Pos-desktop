{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local (bundled) pages: legacy POS UI, station setup, offline till and the fiscal settings window.",
  "windows": [
    "main",
    "fiscal"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-request-user-attention",
    "core:window:allow-is-focused",
    "log:default",
    "shell:allow-open",
    "sql:default",
    {
      "identifier": "sql:allow-execute",
      "allow": [
        {
          "name": "sqlite:pos-desktop.db"
        }
      ]
    },
    {
      "identifier": "sql:allow-load",
      "allow": [
        {
          "name": "sqlite:pos-desktop.db"
        }
      ]
    },
    "desktop:default",
    "desktop:allow-offline-list-orders",
    "desktop:allow-offline-close-order",
    "desktop:allow-offline-mark-reviewed",
    "desktop:allow-offline-requeue",
    "desktop:allow-offline-resolve-unknown"
  ]
}
