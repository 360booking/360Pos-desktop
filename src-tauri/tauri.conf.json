{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "360restaurants POS",
  "version": "0.1.0",
  "identifier": "com.x360booking.pos",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://localhost:* https://*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "360booking",
    "category": "Business",
    "shortDescription": "360restaurants POS — Windows",
    "longDescription": "360restaurants — Windows POS for 360booking restaurants. Offline-first with local SQLite, integrated Datecs fiscal agent, ESC/POS kitchen printers, and card terminal integration.",
    "windows": {
      "wix": {
        "language": [
          "en-US",
          "ro-RO"
        ]
      },
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "Romanian"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://360booking.ro/api/pos-desktop-updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBKEY"
    }
  }
}
